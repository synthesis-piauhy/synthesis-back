APP_ENV=production
DEBUG=false
# Generate an exclusive value with: openssl rand -base64 48
SECRET_KEY=
ALLOWED_HOSTS=synthesis.example.org
PUBLIC_ORIGIN=https://synthesis.example.org
TRUST_PROXY=true
DATABASE_URL=postgresql://synthesis:PASSWORD@127.0.0.1:5432/synthesis
# Only for a database restricted to loopback/private local containers on this host.
# Remote databases must instead use sslmode=verify-full and the trusted CA.
DATABASE_LOCAL_PRIVATE=true
MEDIA_ROOT=/srv/synthesis/media
SECURE_HSTS_SECONDS=3600
