[Unit]
Description=Synthesis Django API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=synthesis-back
Group=synthesis-back
WorkingDirectory=/srv/synthesis/backend
EnvironmentFile=/etc/synthesis/backend.env
ExecStart=/srv/synthesis/backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 60
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/synthesis/media

[Install]
WantedBy=multi-user.target
