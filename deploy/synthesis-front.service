[Unit]
Description=Synthesis Next.js frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=synthesis-front
Group=synthesis-front
WorkingDirectory=/srv/synthesis/frontend
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node /srv/synthesis/frontend/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
